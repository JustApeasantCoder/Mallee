{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mallee",
  "version": "1.0.3",
  "identifier": "dev.mallee.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mallee",
        "width": 1480,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
