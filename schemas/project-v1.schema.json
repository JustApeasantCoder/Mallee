{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallee.dev/schema/project-v1.json",
  "title": "Mallee project manifest v1",
  "type": "object",
  "required": ["schema_version", "id", "name"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "project": {
      "type": "object",
      "properties": {
        "working_directory": { "type": "string", "default": "." }
      },
      "additionalProperties": false
    },
    "logs": {
      "type": "object",
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "open_with_deebugee": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "program": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "operation": {
            "type": "string",
            "enum": ["open_project_folder", "open_log_folder"]
          },
          "working_directory": { "type": "string" },
          "kind": { "type": "string", "enum": ["task", "long_running"] },
          "terminal": { "type": "string", "enum": ["captured", "interactive", "hidden"] },
          "concurrency": {
            "type": "string",
            "enum": ["allow", "reject", "replace_same_action"]
          },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "confirm": { "type": "boolean" }
        },
        "oneOf": [
          { "required": ["program"], "not": { "required": ["operation"] } },
          { "required": ["operation"], "not": { "required": ["program"] } }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
